---
import { UtensilsCrossed } from "@lucide/astro";
---

<header class="site-header">
  <nav class="site-container navbar" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="Stack Cheff home">
      <span class="brand__mark" aria-hidden="true"><UtensilsCrossed size={21} stroke-width={2.2} /></span>
      <span>Stack Cheff</span>
    </a>
    <ul class="nav-links">
      <li><a href="#kitchen">Features</a></li>
      <li><a href="#menu">Pricing</a></li>
      <li><a href="#">Docs</a></li>
    </ul>
    <div class="nav-actions">
      <a class="nav-login" href="/login">Login</a>
      <a class="button button--primary button--nav" href="/register">Get Started</a>
    </div>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--border); background: rgba(2, 4, 10, .82); backdrop-filter: blur(20px) saturate(140%); }
  .navbar { min-height: 4.75rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.7rem; width: fit-content; color: #fff; font-size: 1.05rem; font-weight: 650; letter-spacing: -0.025em; text-decoration: none; }
  .brand__mark { display: grid; width: 2.4rem; height: 2.4rem; place-items: center; border: 1px solid var(--border-blue); border-radius: var(--radius-sm); background: var(--surface); color: var(--primary-bright); box-shadow: 0 0 24px rgba(59,130,246,.14); }
  .nav-links, .nav-actions { display: flex; align-items: center; }
  .nav-links { gap: .25rem; margin: 0; padding: 0; list-style: none; }
  .nav-links a, .nav-login { border-radius: .5rem; color: var(--text-muted); font-size: .875rem; font-weight: 550; text-decoration: none; transition: color 180ms ease, background-color 180ms ease; }
  .nav-links a { padding: .65rem .8rem; }
  .nav-links a:hover, .nav-login:hover { color: #fff; }
  .nav-links a:hover { background: rgba(59,130,246,.1); }
  .nav-actions { justify-content: flex-end; gap: .5rem; }
  .nav-login { padding: .7rem .85rem; }
  .button--nav { min-height: 2.65rem; padding-inline: 1.15rem; }

  @media (max-width: 760px) {
    .navbar { grid-template-columns: 1fr auto; gap: .5rem 1rem; padding-block: .75rem; }
    .nav-links { grid-column: 1 / -1; grid-row: 2; justify-content: center; border-top: 1px solid var(--border-soft); padding-top: .45rem; }
    .nav-actions { grid-column: 2; grid-row: 1; }
  }
  @media (max-width: 430px) {
    .brand { font-size: .95rem; }
    .brand__mark { width: 2.2rem; height: 2.2rem; }
    .nav-login { display: none; }
    .button--nav { min-height: 2.4rem; padding-inline: .9rem; font-size: .78rem; }
    .nav-links { justify-content: space-between; }
    .nav-links a { padding: .55rem .7rem; font-size: .8rem; }
  }
</style>
