---
import { Github, Container, BrainCircuit, type Icon as IconType } from '@lucide/astro';

interface KitchenProps {
  title: string;
    text: string;
    icon: typeof IconType;
}

let kitchenItems: KitchenProps[] = [
    {
      title: 'AI-Powered Configs',
      text: 'Intelligent stack generation tailored to your project needs using advanced AI models. No more generic templates.',
      icon: BrainCircuit,
    },
    {
        title: 'Docker Ready',
        text: 'Containerization baked in from the start for seamless deployment across any environment. Dev, Staging, Prod—ready.',
        icon: Container,
    },
    {
        title: 'GitHub Integration',
        text: ' Automated CI/CD pipelines and repository setup to get your code moving instantly from the very first commit.',
        icon: Github,
    },
];

---

<div class="container-kitchen" id="kitchen">
  <h1 class="kitchen-title">The Ultimate Developer Kitchen</h1>
  <p class="kitchen-text d-flex flex-column">
    Everything you need to ship faster without the configuration headache. Our
    ingredients are sourced from industry standards.
  </p>

 <div class="cards">
     { kitchenItems.map((item) =>
  <div class="card">
    <div class="card-body">
        <div class="icon-container">
            <div class="card-icon">
                <item.icon size={36} color='#c7ddeb' stroke-width={2}/>
            </div>
        </div>
        <h5 class="card-title">{item.title}</h5>
          <p class="card-text">
              {item.text}
          </p>
    </div>
  </div>)}
 </div>
</div>

<style>
  
  .container-kitchen {
    background-color: #c7ddeb;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-left: clamp(1rem, 5vw, 3rem);
    padding-right: clamp(1rem, 5vw, 3rem);
    padding-top: 5rem;
    padding-bottom: 5rem;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-bottom: 0;
    
  }
  .kitchen-title {
    font-size: 3rem;
    font-weight: bold;
    color: #0A2540;
  }
  .kitchen-text {
    font-size: 1.2rem;
    color: #0A2540;
    max-width: 600px;
    margin-top: 1.5rem;
  }

  .cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    margin-top: 3rem;
    gap: 60px;
  }

  .card{
    background: rgba(255, 255, 255, 0.3);
    border: none;
    width: 28rem; 
    height: 20rem;
    border-radius: 15px;
  }

  .card:hover{ 
    cursor: pointer;
    box-shadow: -1px 24px 52px -21px rgba(138,138,138,0.75);
    -moz-box-shadow: -1px 24px 52px -21px rgba(138,138,138,0.75);
    -webkit-box-shadow: -1px 24px 52px -21px rgba(138,138,138,0.75);
  }

  .card:hover .icon-container{
    transform: translateY(-5px);
  }


  .icon-container{/*TODO fix the transform upscale for the icon referecing the card*/
    display: flex;
    align-items: center;
    justify-content: center;
    color: #c7ddeb;
    background-color: #0A2540;
    transition: transform 0.3s ease;
    border-radius: 15px;
    width: 65px;
    height: 65px;
    margin-bottom: 1.5rem;
  }

  .icon {
    width: 50px;
    height: 50px;
  }

  .card-icon:hover{
    transform: translateY(-5px);
  }
  .card-body{
    width: 90%;
    margin-left: 5%;
    margin-top: 5%;
    margin-bottom: 5%;
  }

  .card-title{
    display: flex;
    text-align: start;
    font-weight: bold;
    font-size: 1.3rem;
  }

  .card-text{
    display: flex;
    text-align: start;
    font-weight: 500;
    font-size: 1.1rem;
    margin-bottom: 5%;
    color:#0A2540
  }
</style>
