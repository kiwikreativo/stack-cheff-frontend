---
interface MenuProps {
  title: string;
  description: string[];
  btnText: string;
  price?: string;
}

    let menuItems: MenuProps[] = [
    {
      title: 'Sous Chef',
      description: [
             '5 Boilerplates/mo',
             'Standard Support',
             'Public Repos Only',
      ],
      btnText: 'Get Started',
      price: '$0',
    },
    {
        title: 'Head Chef',
        description: [
             '30 Boilerplates/mo',
             'Standard Support',
             'Public Repos and Private Repos',
      ],
        btnText: 'Go Pro',
        price: '$20',
    },
    
    {
        title: 'Executive*',
        description: [
             'Custom quantity Boilerplates/mo',
             'Priority Support',
             'Enterprise Security',
      ],
        btnText: 'Contact Sales',
        price: '$99',
    },
];
---

<div class="container-menu">
    <h1 class="menu-title">Choose Your Menu</h1>
  <p class="menu-text d-flex flex-column">
    Scale production as you grow. No hidden ingredients.
  </p>

  <div class="cards d-flex flex-wrap">
    {menuItems.map((item: MenuProps) => (
        <div class={`card ${item.title === 'Head Chef' ? 'card-featured' : 'card-standard'}`}>
            <div class="card-body">
                <div class="card-title">{item.title}</div>
                <div class="card-price">{item.price} <div class="c-mo">/mo</div> </div>
                <button class="btn-action">{item.btnText}</button>
                <ul class="cards-description">
                    {item.description.map((desc) => (
                        <li><i class="fa-regular fa-circle-check"></i>
                            {desc}</li>
                    ))}
                </ul>
            </div>
        </div>
    ),)}
     
  </div>
</div>


<style>

    /* TODO correct the responsive to set the cards to the center and the background color white spaceb */
    .container-menu {
        background-color: rgba(199, 221, 235, 0.3);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding-left: clamp(1rem, 5vw, 3rem);
        padding-right: clamp(1rem, 5vw, 3rem);
        padding-top: 5rem;
        padding-bottom: 5rem;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-bottom: 10vh;
    
  }
  .menu-title {
    font-size: 3rem;
    font-weight: bold;
    color: #0A2540;
  }
  .menu-text {
    font-size: 1.2rem;
    color: #0A2540;
    max-width: 700px;
    margin-top: 1rem;
  }

  .cards{
    gap: 4rem;
    margin-top: 5%;
  }

  .card{
    width: 28rem; 
    height: 28rem;
    border-radius: 20px;
  }

  .card-featured {
    background-color: #0A2540;
    color: #c7ddeb;
    border: 2px solid #0A2540;
  }

  .card-featured:hover{
    border: 1px solid #c7ddeb;
  }

  .card-standard {
    background-color: rgba(199, 221, 235, 0.3);
    color: #0A2540;
    border: 1px solid #e0e0e0;
  }

  .card-standard:hover{
    border: 1px solid #0A2540;
  }
  
  .card-body{
    text-align: left;
  }

  .card-title{
    font-size: 1.5rem;
    font-weight: bold;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    margin-left: 15px;
  }

  .card-price{
    font-size: 2.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    margin-left: 15px;
  }

  .c-mo{
    font-size: 1.2rem;
    font-weight: 400;
    display: inline;
    margin-left: -25px;
  }

  .cards-description{
    list-style-type: none;
    padding-left: 1.5rem;
    font-size: 1.1rem;
    font-weight: 520;
    line-height: 3.5rem;
  }


  .btn-action{
    background-color: #0A2540;
    color: #ffffff;
    border: none;
    padding: 1.2rem 3rem;
    border-radius: 15px;
    cursor: pointer;
    margin-bottom: 1rem;
    margin-left: 18px;
    width: 90%;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .card-featured .btn-action {
    background-color: #c7ddeb;
    color: #0A2540;
    
  }


</style>