---
interface MenuProps {
  title: string;
  description: string[];
  btnText: string;
  btnLink: string;
  price?: string;
}

    let menuItems: MenuProps[] = [
    {
      title: 'Sous Chef',
      description: [
             '5 Boilerplates/mo',
             'Standard Support',
             'Public Repos Only',
      ],
      btnText: 'Get Started',
      btnLink: '/register',
      price: '$0',
    },
    {
        title: 'Head Chef',
        description: [
             '15 Boilerplates/mo',
             'Standard Support',
             'Public Repos and Private Repos',
       ],
        btnText: 'Go Pro',
        btnLink: '/pricing?plan=Head%20Chef',
        price: '$20',
    },
    
    {
        title: 'Executive',
        description: [
             '30 Boilerplates/mo',
             'Priority Support',
             'Enterprise Security',
       ],
        btnText: 'Go Executive',
        btnLink: '/pricing?plan=Executive',
        price: '$60',
    },
];
---

<div class="container-menu" id="menu">
    <h1 class="menu-title">Choose Your Menu</h1>
  <p class="menu-text d-flex flex-column">
    Scale production as you grow. No hidden ingredients.
  </p>

  <div class="cards d-flex flex-row flex-wrap justify-content-center gap-4 mt-5">
    {menuItems.map((item: MenuProps) => (
        <div class={`card ${item.title === 'Head Chef' ? 'card-featured' : 'card-standard'}`}>
            <div class="card-body">
                <div class="card-title">{item.title}</div>
                <div class="card-price">{item.price} <div class="c-mo">/mo</div> </div>
                <a href={item.btnLink} class="btn-action">{item.btnText}</a>
                <ul class="cards-description">
                    {item.description.map((desc) => (
                        <li><i class="fa-regular fa-circle-check"></i>
                            {desc}</li>
                    ))}
                </ul>
            </div>
        </div>
    ),)}
     
  </div>
</div>


  <style>

      .container-menu {
        background-color: rgba(199, 221, 235, 0.3);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding-left: clamp(1rem, 5vw, 3rem);
        padding-right: clamp(1rem, 5vw, 3rem);
        padding-top: 3rem;
        padding-bottom: 3rem;
        width: 100vw;
        margin-left: calc(-50vw + 50%);    
  }
  .menu-title {
    font-size: 1.8rem;
    font-weight: bold;
    color: #0A2540;
  }
  .menu-text {
    font-size: 1rem;
    color: #0A2540;
    max-width: 700px;
    margin-top: 0.5rem;
  }

  .cards{
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.1rem;
    margin-top: 5%;
    width: 100vw;
  }

  .card{
    width: 25%;
    min-width: 280px; 
    min-height: 26rem;
    border-radius: 20px;
  }

  .card-featured {
    background-color: #0A2540;
    color: #c7ddeb;
    border: 2px solid #0A2540;
  }

  .card-featured:hover{
    border: 1px solid #c7ddeb;
  }

  .card-standard {
    background-color: rgba(199, 221, 235, 0.3);
    color: #0A2540;
    border: 1px solid #e0e0e0;
  }

  .card-standard:hover{
    border: 1px solid #0A2540;
  }
  
  .card-body{
    text-align: left;
  }

  .card-title{
    font-size: 1.3rem;
    font-weight: bold;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    margin-left: 15px;
  }

  .card-price{
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    margin-left: 15px;
  }

  .c-mo{
    font-size: 1rem;
    font-weight: 400;
    display: inline;
    margin-left: -15px;
  }

  .cards-description{
    list-style-type: none;
    padding-left: 1rem;
    font-size: 0.95rem;
    font-weight: 520;
    line-height: 2.8rem;
  }


  .btn-action{
    background-color: #0A2540;
    color: #ffffff;
    border: none;
    padding: 1rem 2rem;
    border-radius: 12px;
    cursor: pointer;
    text-decoration: none;
    /* width: calc(50% - 20px); */
    width: fit-content;
    font-size: 1rem;
    font-weight: 600;
    display: block;
    margin: 10px 15px 15px;
  }

  .card-featured .btn-action {
    background-color: #c7ddeb;
    color: #0A2540;
  }

  /* Responsive for 360px screens */
  @media (max-width: 480px) {
    .container-menu {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    .menu-title {
      font-size: 1.5rem;
    }

    .menu-text {
      font-size: 0.9rem;
    }

    .cards {
      gap: 1rem;
      margin-top: 3%;
    }

    .card {
      max-width: 18rem;
      min-height: 24rem;
    }

    .card-title {
      font-size: 1.1rem;
      margin-top: 0.75rem;
    }

    .card-price {
      font-size: 1.75rem;
    }

    .c-mo {
      font-size: 0.9rem;
      margin-left: -12px;
    }

    .cards-description {
      font-size: 0.85rem;
      line-height: 2.5rem;
      padding-left: 0.75rem;
    }

    .btn-action {
      padding: 0.8rem 1.5rem;
      font-size: 0.9rem;
      border-radius: 10px;
    }
  }

  @media (min-width: 481px) and (max-width: 768px) {
    .cards {
      gap: 1.25rem;
    }

    .card {
      max-width: 20rem;
      min-height: 25rem;
    }
  }

</style>
