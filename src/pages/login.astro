---
import Layout from "../layouts/Layout.astro";
import LogoCheff from "../assets/StackChefflogo.png";
import { UtensilsCrossed } from "@lucide/astro";
---


<Layout>
  <div class="containerLogin">
    <a href="/" class="backmain"
      ><i class="fa-solid fa-arrow-left text-black"></i> Back to main</a
    >
    <div class="card">
        <div class="navbar-logo d-flex align-items-center gap-3">
            <span class="logo-icon py-2 px-2 flex items-center justify-center"  >
                <UtensilsCrossed class="size-8" />
            </span>
            <h1 class="mb-3" style="font-weight: bold; font-size: 2rem;">Stack Cheff</h1>
        </div>
      <span>Welcome back! Please enter your credentials.</span>
      <button class="mb-5 font-bold btn-github"
        ><i class="fa-brands fa-github mr-3 text-xl"></i>Continue with Github</button
      >
      <div class="row">
        <div class="col-3"><hr /></div>
        <div class="col-6">
          <p class="text-sm text-uppercase">Or continue with email</p>
        </div>
        <div class="col-3"><hr /></div>
      </div>

      <form>
        <div class="email">
          <label for="email" class="text-uppercase mb-2 mt-2">Email</label>
          <input
            class="form-input flex w-full rounded-lg text-dark-navy focus:ring-2 focus:ring-dark-navy/20 border-glass-border bg-white/50 focus:bg-white h-14 placeholder:text-dark-navy/30 pl-12 text-base font-medium transition-all"
            placeholder="chef@stack.io"
            type="email"
          />
        </div>
        <div class="password">
          <label for="password" class="text-uppercase mb-2 mt-2">Password</label
          >
          <a href="#" class="text-dark-navy/70 font-medium" style="margin-left: 44%;">Forgot Password?</a>
          <input
            class="form-input flex w-full rounded-lg text-dark-navy focus:ring-2 focus:ring-dark-navy/20 border-glass-border bg-white/50 focus:bg-white h-14 placeholder:text-dark-navy/30 pl-12 text-base font-medium transition-all"
            placeholder="••••••••"
            type="password"
          />
        </div>
        <button type="submit" class="font-bold mt-3"
          >Sign in to Kitchen <i class="fa-solid fa-utensils ml-3 text-xl"
          ></i></button
        >
      </form>
      <div class="mt-4 text-center">
        <p class="text-dark-navy/70 font-medium">
          Don't have an account?
        <a
            class="text-dark-navy font-black  ml-1"
            style="text-decoration: none; color: #0a2540;"
            href="#">Sign up
        </a>
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .containerLogin {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: rgba(199, 221, 235, 0.8);
    color: #333;
    margin-top: 15px;
    padding: 2rem;
    height: 100vh;
  }

  .backmain {
    align-self: flex-start;
    margin-bottom: 2rem;
    color: #333;
    text-decoration: none;
    font-weight: 500;
    margin-left: 35%;
  }

  .card {
    background: rgba(199, 221, 235, 0.3);
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    width: 32rem;
  }

  .card h2 {
    margin-bottom: 1rem;
  }

  .card span {
    display: block;
    margin-bottom: 1.5rem;
  }

  .card form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card input {
    padding: 0.5rem;
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  .card button {
    padding: 1rem;
    background-color: #0a2540;
    color: #fff;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    margin-top: 0.5rem;
    gap: 2px;
  }

  .btn-github {
    background-color: white !important;
    color: #0a2540 !important;
  }

  /* Responsive styles for xs screens (320px+) */
  @media (min-width: 320px) {
    .containerLogin {
      padding: 0.75rem;
      height: auto;
      min-height: 100vh;
    }

    .backmain {
      margin-left: 0;
      margin-bottom: 1rem;
      font-size: 0.875rem;
    }

    .card {
      width: 100%;
      max-width: 20rem;
      padding: 1rem;
    }

    .card .navbar-logo {
      gap: 0.5rem;
      margin-bottom: 0.75rem;
    }

    .card .logo-icon {
      padding: 0.375rem;
    }

    .card .logo-icon :global(.size-8) {
      width: 1.5rem;
      height: 1.5rem;
    }

    .card h2 {
      font-size: 1rem;
      margin-bottom: 0.5rem;
    }

    .card span {
      font-size: 0.875rem;
      margin-bottom: 0.75rem;
    }

    .card .btn-github {
      padding: 0.75rem;
      font-size: 0.875rem;
      margin-bottom: 0.75rem;
    }

    .card .btn-github :global(.text-xl) {
      font-size: 1rem;
      margin-right: 0.5rem;
    }

    .card input {
      height: 2.5rem;
      font-size: 0.875rem;
      padding-left: 2.75rem;
    }

    .card form {
      gap: 0.5rem;
    }

    .card button[type="submit"] {
      padding: 0.625rem;
      font-size: 0.875rem;
    }

    .card p.text-sm {
      font-size: 0.75rem;
    }
  }

  /* Responsive styles for sm screens (640px+) */
  @media (min-width: 640px) {
    .containerLogin {
      padding: 2rem;
    }

    .backmain {
      margin-left: 35%;
      margin-bottom: 2rem;
      font-size: 1rem;
    }

    .card {
      width: 32rem;
      max-width: 32rem;
      padding: 2rem;
    }

    .card .navbar-logo {
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .card .logo-icon {
      padding: 0.5rem;
    }

    .card .logo-icon :global(.size-8) {
      width: 2rem;
      height: 2rem;
    }

    .card h2 {
      font-size: 1.25rem;
      margin-bottom: 1rem;
    }

    .card span {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }

    .card .btn-github {
      padding: 1rem;
      font-size: 1rem;
      margin-bottom: 1.25rem;
    }

    .card .btn-github :global(.text-xl) {
      font-size: 1.25rem;
      margin-right: 0.75rem;
    }

    .card input {
      height: 3.5rem;
      font-size: 1rem;
      padding-left: 3rem;
    }

    .card form {
      gap: 1rem;
    }

    .card button[type="submit"] {
      padding: 1rem;
      font-size: 1rem;
    }

    .card p.text-sm {
      font-size: 0.875rem;
    }
  }
</style>